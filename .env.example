# کپی کن به .env و مقادیر را پر کن (هرگز .env را commit نکن)

# --- هوش مصنوعی (AvalAI) ---
AVALAI_API_KEY=
AVALAI_MODEL=claude-opus-5
AVALAI_BASE_URL=https://api.avalai.ir/v1

# --- تلگرام ---
TELEGRAM_BOT_TOKEN=
# اختیاری؛ خالی بگذار تا خودکار ساخته شود
TELEGRAM_WEBHOOK_SECRET=

# --- دیتابیس (برای docker-compose محلی؛ روی Railway متغیرهای MYSQL* خودش ست می‌شوند) ---
MYSQL_ROOT_PASSWORD=devroot
MYSQLDATABASE=chatbot
MYSQLUSER=chatbot
MYSQLPASSWORD=chatbot
